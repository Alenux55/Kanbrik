# Disposable local database only. Required for account/workspace operations.
# Replace the placeholder password in both values before starting Compose.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://kanbrik_dev:replace-with-local-password@127.0.0.1:5433/kanbrik_dev?schema=public
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a random secret, at least 32 characters. Never reuse production secrets.
BETTER_AUTH_SECRET=replace-with-a-generated-random-secret
# Registration is off unless BOTH settings below explicitly opt in, and URL is loopback.
# These settings are independent of NODE_ENV; local production-mode tests work.
KANBRIK_ENV=local
ENABLE_LOCAL_REGISTRATION=true
