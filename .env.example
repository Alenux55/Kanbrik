# Disposable local database only. Required for account/workspace operations.
# Replace the placeholder password in both values before starting Compose.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://kanbrik_dev:replace-with-local-password@127.0.0.1:5433/kanbrik_dev?schema=public
BETTER_AUTH_URL=http://127.0.0.1:3000
# Generate a random secret, at least 32 characters. Never reuse production secrets.
BETTER_AUTH_SECRET=replace-with-a-generated-random-secret
# Registration is off unless BOTH settings below explicitly opt in, and URL is loopback.
# These settings are independent of NODE_ENV; local production-mode tests work.
KANBRIK_ENV=local
ENABLE_LOCAL_REGISTRATION=true
# Optional HTTPS preview behind your reverse proxy. Set KANBRIK_ENV=preview and
# BETTER_AUTH_URL=https://your-subdomain to use this separate opt-in.
# Only enable while accepting preview accounts; anyone who can reach the app can sign up.
ENABLE_PREVIEW_REGISTRATION=false

# Password reset is off until enabled with complete SMTP settings. Restart the app after editing.
PASSWORD_RESET_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Authorized sender: email@example.com or "Kanbrik Notifications <email@example.com>"
SMTP_FROM=
# Port 465 uses implicit TLS; other ports require STARTTLS.
# Plain SMTP is permitted ONLY for a loopback local/test server with this explicit flag:
SMTP_ALLOW_INSECURE_LOCAL=false
