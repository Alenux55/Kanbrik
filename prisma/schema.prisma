generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  personalWorkspace Workspace? @relation("PersonalOwner")
  memberships Membership[]
  boardPreference BoardPreference?
  calendarPreference CalendarPreference?
  plannerPreference PlannerPreference?
  sentInvitations AccountInvitation[]
  trashOperations TrashBatch[]
  workComments WorkComment[]
  workActivities WorkActivity[]
  @@map("user")
  workspaceActivity WorkspaceActivity[]
  operationIntents WorkspaceIntent[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

enum WorkspaceKind {
  personal
  shared
}

enum WorkspaceRole {
  owner
  editor
}

model Workspace {
  tags WorkspaceTag[]
  taskTags TaskTag[]
  id              String @id @default(cuid())
  name            String
  kind            WorkspaceKind
  timeZone        String @default("UTC")
  settingsRevision Int @default(1)
  personalOwnerId String? @unique
  personalOwner   User? @relation("PersonalOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  projects        Project[]
  tasks           Task[]
  timeBlocks      TimeBlock[]
  calendarIntents CalendarCreateIntent[]
  trashBatches TrashBatch[]
  comments WorkComment[]
  activities WorkActivity[]
  createdAt       DateTime @default(now())
  workLists WorkList[]
  workItems WorkListItem[]
  vendors WorkspaceVendor[]
  configurationActivity WorkspaceActivity[]
  operationIntents WorkspaceIntent[]
  statuses WorkspaceStatus[]
  workflow WorkspaceWorkflow?
  taskOrders TaskOrderScope[]
}

model Membership {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId])
}



model BoardPreference {
  userId String @id
  workspaceIds String[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String @id @default(cuid())
  workspaceId String
  title       String
  description String @default("")
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  trashBatchId String?
  trashBatch TrashBatch? @relation(fields: [workspaceId, trashBatchId], references: [workspaceId, id], onDelete: NoAction)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  timeBlocks  TimeBlock[]
  comments WorkComment[]
  activities WorkActivity[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, trashBatchId])
  workLists WorkList[]
  taskOrders TaskOrderScope[]
}

model Task {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String?
  parentId    String?
  title       String
  description String @default("")
  status      String @default("todo")
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  trashBatchId String?
  trashBatch TrashBatch? @relation(fields: [workspaceId, trashBatchId], references: [workspaceId, id], onDelete: NoAction)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  parent      Task? @relation("Subtasks", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  children    Task[] @relation("Subtasks")
  timeBlocks  TimeBlock[]
  comments WorkComment[]
  activities WorkActivity[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt, id])
  @@index([projectId, workspaceId])
  @@index([parentId, workspaceId])
  @@index([workspaceId, trashBatchId])
  workLists WorkList[]
  workflowStatus WorkspaceStatus @relation(fields:[workspaceId,status], references:[workspaceId,id], onDelete:NoAction)
  tagLinks TaskTag[]
  childOrders TaskOrderScope[] @relation("ChildOrder")
}

model ActivityBoundary {
  id String @id
  activatedAt DateTime @default(now()) @db.Timestamptz(3)
}

model WorkComment {
  id String @id @default(cuid())
  workspaceId String
  projectId String?
  taskId String?
  authorId String?
  authorName String
  requestKey String
  createText String
  text String
  revision Int @default(1)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  editedAt DateTime? @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  task Task? @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  activities WorkActivity[]
  @@unique([workspaceId, id])
  @@unique([workspaceId, requestKey])
  @@index([workspaceId, projectId, createdAt, id])
  @@index([workspaceId, taskId, createdAt, id])
}

model WorkActivity {
  id String @id @default(cuid())
  workspaceId String
  projectId String?
  taskId String?
  actorId String?
  actorName String
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  eventKey String
  action String
  workRevision Int?
  commentRevision Int?
  commentId String?
  changes Json
  operationId String?
  operationTitle String?
  operationKind String?
  cascade Boolean @default(false)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  task Task? @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  comment WorkComment? @relation(fields: [workspaceId, commentId], references: [workspaceId, id], onDelete: NoAction)
  @@unique([workspaceId, eventKey])
  @@index([workspaceId, projectId, occurredAt, id])
  @@index([workspaceId, taskId, occurredAt, id])
  subjectKind String?
  subjectId String?
  subjectRevision Int?
}

model TrashBatch {
  workspaceId String
  id String
  rootKind String
  rootId String
  rootTitle String
  impactDigest String
  members Json
  revision Int @default(1)
  createdAt DateTime @default(now())
  restoredAt DateTime?
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects Project[]
  tasks Task[]
  @@id([workspaceId, id])
  @@index([workspaceId, createdAt, id])
}

model CalendarPreference {
  userId String @id
  workspaceIds String[]
  timeZone String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimeBlock {
  id String @id @default(cuid())
  workspaceId String
  label String @default("Time block")
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  timeZone String
  projectId String?
  taskId String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  task Task? @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  @@index([workspaceId, startAt, endAt])
  @@index([projectId, workspaceId])
  @@index([taskId, workspaceId])
}

model CalendarCreateIntent {
  workspaceId String
  requestKey String
  payload String
  blockId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([workspaceId, requestKey])
}

model PlannerPreference {
  userId String @id
  defaultWorkspaceId String?
  timeZone String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountInvitation {
  id String @id @default(cuid())
  email String @unique
  tokenHash String @unique
  inviterId String
  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  @@index([inviterId, createdAt])
}


model WorkList {
  id String @id @default(cuid())
  workspaceId String
  projectId String?
  taskId String?
  kind String
  name String
  revision Int @default(1)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  task Task? @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  items WorkListItem[]
  @@unique([workspaceId,id,kind])
  @@unique([workspaceId,id])
  @@index([workspaceId,projectId,createdAt,id])
  @@index([workspaceId,taskId,createdAt,id])
}
model WorkListItem {
  id String @id @default(cuid())
  workspaceId String
  listId String
  kind String
  text String
  checked Boolean @default(false)
  quantity Decimal? @db.Decimal(12,3)
  vendorId String?
  purchased Boolean @default(false)
  revision Int @default(1)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list WorkList @relation(fields: [workspaceId,listId,kind], references: [workspaceId,id,kind], onDelete: Cascade)
  vendor WorkspaceVendor? @relation(fields: [workspaceId,vendorId], references: [workspaceId,id], onDelete: NoAction)
  @@unique([workspaceId,id])
  @@index([workspaceId,listId,createdAt,id])
}
model WorkspaceVendor {
  id String @id @default(cuid())
  workspaceId String
  name String
  revision Int @default(1)
  archivedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  items WorkListItem[]
  @@unique([workspaceId,id])
  @@index([workspaceId,createdAt,id])
}
model WorkspaceActivity {
  id String @id @default(cuid())
  workspaceId String
  actorId String?
  actorName String
  occurredAt DateTime @default(now()) @db.Timestamptz(3)
  action String
  subjectId String
  revision Int
  changes Json
  eventKey String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@unique([workspaceId,eventKey])
  @@index([workspaceId,occurredAt,id])
}
model WorkspaceIntent {
  workspaceId String
  id String
  kind String
  actorId String?
  payload Json
  result Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@id([workspaceId,id])
}

model WorkspaceStatus {
 workspaceId String
 id String
 name String
 position Int
 completed Boolean @default(false)
 revision Int @default(1)
 archivedAt DateTime? @db.Timestamptz(3)
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 tasks Task[]
 defaults WorkspaceWorkflow[]
 @@id([workspaceId,id])
 @@index([workspaceId,position,id])
}
model WorkspaceWorkflow {
 workspaceId String @id
 revision Int @default(1)
 defaultStatusId String @default("todo")
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 defaultStatus WorkspaceStatus @relation(fields:[workspaceId,defaultStatusId],references:[workspaceId,id],onDelete:NoAction)
}

model TaskOrderScope {
 workspaceId String
 scopeKey String
 projectId String?
 parentId String?
 ids String[]
 revision Int @default(1)
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade)
 project Project? @relation(fields:[projectId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 parent Task? @relation("ChildOrder",fields:[parentId,workspaceId],references:[id,workspaceId],onDelete:Cascade)
 @@id([workspaceId,scopeKey])
}

model WorkspaceTag {
 id String @id @default(cuid())
 workspaceId String
 name String
 normalizedName String
 color String
 revision Int @default(1)
 archivedAt DateTime? @db.Timestamptz(3)
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 tasks TaskTag[]
 @@unique([workspaceId,id])
 @@unique([workspaceId,normalizedName])
}
model TaskTag {
 workspaceId String
 taskId String
 tagId String
 workspace Workspace @relation(fields:[workspaceId],references:[id],onDelete:Cascade,onUpdate:NoAction)
 task Task @relation(fields:[taskId,workspaceId],references:[id,workspaceId],onDelete:Cascade,onUpdate:NoAction)
 tag WorkspaceTag @relation(fields:[workspaceId,tagId],references:[workspaceId,id],onDelete:NoAction,onUpdate:NoAction)
 @@id([workspaceId,taskId,tagId])
}
