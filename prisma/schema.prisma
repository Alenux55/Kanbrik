generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  personalWorkspace Workspace? @relation("PersonalOwner")
  memberships Membership[]
  boardPreference BoardPreference?
  calendarPreference CalendarPreference?
  plannerPreference PlannerPreference?
  sentInvitations AccountInvitation[]
  trashOperations TrashBatch[]
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("session")
}

model Account {
  id                     String    @id
  accountId              String
  providerId             String
  userId                 String
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}

enum WorkspaceKind {
  personal
  shared
}

enum WorkspaceRole {
  owner
  editor
}

model Workspace {
  id              String @id @default(cuid())
  name            String
  kind            WorkspaceKind
  timeZone        String @default("UTC")
  settingsRevision Int @default(1)
  personalOwnerId String? @unique
  personalOwner   User? @relation("PersonalOwner", fields: [personalOwnerId], references: [id], onDelete: Cascade)
  memberships     Membership[]
  projects        Project[]
  tasks           Task[]
  timeBlocks      TimeBlock[]
  calendarIntents CalendarCreateIntent[]
  trashBatches TrashBatch[]
  createdAt       DateTime @default(now())
}

model Membership {
  id          String @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId])
}

enum TaskStatus {
  backlog
  todo
  in_progress
  blocked
  done
}

model BoardPreference {
  userId String @id
  workspaceIds String[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Project {
  id          String @id @default(cuid())
  workspaceId String
  title       String
  description String @default("")
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  trashBatchId String?
  trashBatch TrashBatch? @relation(fields: [workspaceId, trashBatchId], references: [workspaceId, id], onDelete: NoAction)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks       Task[]
  timeBlocks  TimeBlock[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt, id])
  @@index([workspaceId, trashBatchId])
}

model Task {
  id          String @id @default(cuid())
  workspaceId String
  projectId   String?
  parentId    String?
  title       String
  description String @default("")
  status      TaskStatus @default(todo)
  revision    Int @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  trashBatchId String?
  trashBatch TrashBatch? @relation(fields: [workspaceId, trashBatchId], references: [workspaceId, id], onDelete: NoAction)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  parent      Task? @relation("Subtasks", fields: [parentId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  children    Task[] @relation("Subtasks")
  timeBlocks  TimeBlock[]
  @@unique([id, workspaceId])
  @@index([workspaceId, createdAt, id])
  @@index([projectId, workspaceId])
  @@index([parentId, workspaceId])
  @@index([workspaceId, trashBatchId])
}

model TrashBatch {
  workspaceId String
  id String
  rootKind String
  rootId String
  rootTitle String
  impactDigest String
  members Json
  revision Int @default(1)
  createdAt DateTime @default(now())
  restoredAt DateTime?
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projects Project[]
  tasks Task[]
  @@id([workspaceId, id])
  @@index([workspaceId, createdAt, id])
}

model CalendarPreference {
  userId String @id
  workspaceIds String[]
  timeZone String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TimeBlock {
  id String @id @default(cuid())
  workspaceId String
  label String @default("Time block")
  startAt DateTime @db.Timestamptz(3)
  endAt DateTime @db.Timestamptz(3)
  timeZone String
  projectId String?
  taskId String?
  revision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  task Task? @relation(fields: [taskId, workspaceId], references: [id, workspaceId], onDelete: Restrict)
  @@index([workspaceId, startAt, endAt])
  @@index([projectId, workspaceId])
  @@index([taskId, workspaceId])
}

model CalendarCreateIntent {
  workspaceId String
  requestKey String
  payload String
  blockId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([workspaceId, requestKey])
}

model PlannerPreference {
  userId String @id
  defaultWorkspaceId String?
  timeZone String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AccountInvitation {
  id String @id @default(cuid())
  email String @unique
  tokenHash String @unique
  inviterId String
  inviter User @relation(fields: [inviterId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
  consumedAt DateTime?
  @@index([inviterId, createdAt])
}
